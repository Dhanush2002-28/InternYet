# Copy this file to .env and fill in your Firebase web app config.
# Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration.
# Without these values the app runs in offline DEMO mode (data stays in the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS (optional) - sends the offer letter, payment confirmation and certificate
# emails. Dashboard: https://dashboard.emailjs.com -> copy your Service ID and Public
# Key, create the three templates from the files in email-templates/ and paste their
# template IDs below. With these empty, emails are skipped (the app still works).
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_OFFER_LETTER=
VITE_EMAILJS_TEMPLATE_PAYMENT=
VITE_EMAILJS_TEMPLATE_CERTIFICATE=