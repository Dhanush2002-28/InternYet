# Copy this file to .env and fill in your Firebase web app config.
# Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration.
# Without these values the app runs in offline DEMO mode (data stays in the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Resend server-side email delivery (never prefix these with VITE_)
# Create an API key at https://resend.com and verify a sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Internship Portal